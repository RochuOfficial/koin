{
  "expo": {
    "name": "Piggy",
    "slug": "piggy-mobile",
    "scheme": "piggy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "locales": {
      "pl": "./languages/pl.json",
      "hu": "./languages/hu.json",
      "de": "./languages/de.json"
    },
    "experiments": {
      "reactCompiler": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.piggnify.app.ios",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "CFBundleLocalizations": [
          "en",
          "pl",
          "hu",
          "de"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.piggnify.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "react-native-quick-crypto",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Piggy to unlock the app with Face ID."
        }
      ],
      "./plugins/withoutPushEntitlement",
      "expo-localization",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc860e5f-a78b-422c-8389-56b5d023d94d"
      }
    }
  }
}
